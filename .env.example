# ── Local development defaults ────────────────────────────
# Copy to .env and adjust as needed.
# docker compose up --build -d → http://localhost:3000

POSTGRES_USER=imdev
POSTGRES_PASSWORD=imdev
POSTGRES_DB=imdev
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=dev-local-only-change-in-production-min-32-chars-xx
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auto-create admin account on first deploy (optional for local).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage (Cloudflare R2). When unset, uploads go to public/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
