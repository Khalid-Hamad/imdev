# ── Production (Hostinger VPS) ─────────────────────────────
# Copy to .env.production and fill in real values.
# docker compose --env-file .env.production up --build -d

POSTGRES_USER=imdev
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=imdev
POSTGRES_PORT=127.0.0.1:5432

# Bind app behind Nginx reverse proxy on localhost only.
APP_PORT=127.0.0.1:3100

BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
BETTER_AUTH_URL=https://im.dev
NEXT_PUBLIC_APP_URL=https://im.dev

# Admin account created on first deploy.
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Cloudflare R2 object storage.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=imdev-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.im.dev
